FROM ghcr.io/astral-sh/uv:0.11.28 AS uv

FROM docker.io/library/python:3.12.13-slim-bookworm

ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="Force-Aware TALOS MJLab"
LABEL org.opencontainers.image.description="Reproducible MJLab environment for TALOS tray transport"
LABEL org.opencontainers.image.source="https://github.com/Hazzzard-LYX/MJ-LAB-WBC-FOR-FORCE-AWARE-TALOS"
LABEL org.opencontainers.image.revision="${VCS_REF}"

COPY --from=uv /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all \
    MUJOCO_GL=egl \
    PYTHONUNBUFFERED=1 \
    UV_CONCURRENT_BUILDS=2 \
    UV_CONCURRENT_DOWNLOADS=4 \
    UV_CONCURRENT_INSTALLS=4 \
    UV_LINK_MODE=hardlink \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/pal_mjlab/.venv \
    WARP_CACHE_PATH=/cache/warp \
    PATH="/opt/pal_mjlab/.venv/bin:${PATH}"

WORKDIR /opt/pal_mjlab

# Resolve the large CUDA/Python layer before copying source code so normal code
# edits do not invalidate the dependency cache.
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --extra cu128 --no-install-project \
    && uv cache clean

COPY . .

RUN uv sync --frozen --extra cu128 \
    && uv cache clean \
    && python containers/mjlab/smoke.py --cpu-only \
    && FORCE_CPU=1 python -m pytest -q

WORKDIR /workspace

CMD ["python", "/opt/pal_mjlab/containers/mjlab/smoke.py"]
